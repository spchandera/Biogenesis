

<!-- image-with-accordion.liquid -->

{% liquid 
  assign heading_base_size =  settings.heading_base_size | times: 0.0225
  assign heading_size =  section.settings.heading_size | times: 0.01 | times: heading_base_size

  assign content_position = 'start'
  if section.settings.content_position == 'middle'
    assign content_position = 'center'
  endif
  if section.settings.content_position == 'bottom'
    assign content_position = 'end'
  endif

  assign block_first = section.blocks | first
  assign border_image = section.settings.image_corner_radius | minus: 1

  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
  else
    assign is_rtl = false
  endif
%} 
{%- style -%}
  .border-radius-{{ section.id }} {
    border-radius: {{ border_image }}px;
  }
  .heading-{{ section.id }} {
    font-size: {{ heading_size | times: 0.6 }}rem;
  }
  .heading--{{ section.id }} {
    {%- if section.settings.heading_color.alpha != 0.0 -%}
      color: {{ section.settings.heading_color }};
    {%- else -%}
      color: {{ settings.secondary_heading }};
    {%- endif -%}
  }
  .text--{{ section.id }} {
    {%- if section.settings.text_color.alpha != 0.0 -%}
      color: {{ section.settings.text_color }};
    {%- else -%}
      color: {{ settings.secondary_text }};
    {%- endif -%}
  }
  .background--{{ section.id }} {
    {%- if section.settings.background_color.alpha != 0.0 -%}
      background: {{ section.settings.background_color }};
      --background-color: {{ section.settings.background_color.red }}, {{ section.settings.background_color.green }}, {{ section.settings.background_color.blue }};
    {%- else -%}
      background: rgb(var(--colors-background-secondary));
      --background-color: var(--colors-background-secondary);
    {%- endif -%}
  }
  .dark .heading--{{ section.id }} {
    {%- if section.settings.heading_color_dark.alpha != 0.0 -%}
      color: {{ section.settings.heading_color_dark }};
    {%- else -%}
      color: {{ settings.secondary_heading_dark }};
    {%- endif -%}
  }
  .dark .text--{{ section.id }} {
    {%- if section.settings.text_color_dark.alpha != 0.0 -%}
      color: {{ section.settings.text_color_dark }};
    {%- else -%}
      color: {{ settings.secondary_text_dark }};
    {%- endif -%}
  }
  .dark .background--{{ section.id }} {
    {%- if section.settings.background_color_dark.alpha != 0.0 -%}
      background: {{ section.settings.background_color_dark }};
      --background-color: {{ section.settings.background_color_dark.red }}, {{ section.settings.background_color_dark.green }}, {{ section.settings.background_color_dark.blue }};
    {%- else -%}
      background: rgb(var(--colors-background-secondary));
      --background-color: var(--colors-background-secondary);
    {%- endif -%}
  }
  .section-height--{{ section.id }} {
    {% if section.settings.mobile_height == 'natural' and block_first %}
      {% if block_first.type == 'product' and block_first.settings.product.featured_media and block_first.settings.product.featured_media.media_type != "model" %}
        height: 0px;
        padding-bottom: {{ 1 | divided_by: block_first.settings.product.featured_media.aspect_ratio | times: 100 }}%;
      {% elsif block_first.type == 'collection' and block_first.settings.collection.featured_media %}
        height: 0px;
        padding-bottom: {{ 1 | divided_by: block_first.settings.collection.featured_media.aspect_ratio | times: 100 }}%;
      {% elsif block_first.type == 'media' and block_first.settings.image %}
        height: 0px;
        padding-bottom: {{ 1 | divided_by: block_first.settings.image.aspect_ratio | times: 100 }}%;
      {% else %}
        height: auto;
      {% endif %}
    {% else %}
      height: {{ section.settings.mobile_height }};
    {% endif %}
  }
  @media (min-width: 767px) {
    .heading-{{ section.id }} {
      font-size: {{ heading_size }}rem;
    }
    .section-height--{{ section.id }} {
      {% if section.settings.desktop_height == 'natural' and block_first %}
         height: auto; 
      {% else %}
        height: {{ section.settings.desktop_height }};
        padding-bottom: 0px;
      {% endif %}
    }
  }

  /* ── Accordion animation polish ──────────────────────────────────────── */

  /* Override Alpine x-collapse's default 250ms ease with a premium curve */
  .image-with-accordion [x-collapse] {
    transition: height 420ms cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  /* Arrow icon: GPU-composited rotation */
  .acc-arrow-icon {
    will-change: transform;
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Content fade-in + subtle lift when a panel opens */
  .acc-text--text > div {
    animation: acc-content-reveal 360ms cubic-bezier(0.4, 0, 0.2, 1) 60ms both;
  }

  @keyframes acc-content-reveal {
    from { opacity: 0; transform: translateY(-5px); }
    to   { opacity: 1; transform: translateY(0); }
  }
{%- endstyle -%}

{% render 'section-divider' %}

<div x-ref="flow_container_{{ section.index }}" class="{% if section.index == 1 %}preload-image {% endif %}">
 
  <div 
    class=""
    x-data="{ active: '{{ section.blocks[0].id }}', open_first_tab: {{ section.settings.open_first_tab }}}"
  >

    <div class="background--{{ section.id }} pb-[{{ section.settings.padding_bottom_mobile }}px] pt-[{{ section.settings.padding_top_mobile }}px] md:pb-[{{ section.settings.padding_bottom }}px] md:pt-[{{ section.settings.padding_top }}px]"> 
    <div class="{% unless section.settings.full_width %} page-width mx-auto{% else %}{% if section.settings.padding_full_width %} md:px-5{% else %} md:px-0{% endif %}{% endunless %}{% if section.settings.full_width_mobile %} full-width-mobile{% else %} px-5{% endif %}">
     
     <div class="acc-column-wrap border-radius-{{ section.id }} flex items-{{ content_position }}{% if section.settings.image_position_mobile == 'first' %} flex-col-reverse{% else %} flex-col--{% endif %}{% if is_rtl %} ltr{% endif %}"> 
      
      
       <div class="text-column-wrap 1 w-full h-full md:col-span-2 flex items-{{ content_position }}{% if section.settings.image_position == 'first' %} md:order-2{% endif %}{% if is_rtl %} rtl{% endif %}">
<div class="acc-text-inner">  
         {% if section.settings.heading != blank %}
    <{{ section.settings.heading_tag }} class="heading-text heading-{{ section.id }} h2 block text-{{ section.settings.heading_alignment }} leading-tight p-break-words">
      {% render 'heading-highlight',
        headingId: section.id,
        heading: section.settings.heading,
        highlight_type: section.settings.highlight_type
      %}
    </{{ section.settings.heading_tag }}>
  {% endif %}
      
        <ul class="acc-tabs-wrap w-full text-{{ section.settings.content_alignment }}">
          
          {% for block in section.blocks %}
            {% case block.type %} 
                {% when 'tab' %}
            <li class="acc-tab-item  md:pt-7{% if forloop.first %} pt-2.5{% else %} pt-7{% endif %}">
              <span class="flex flex-row hover:opacity-100 cursor-pointer transition-opacity duration-300 p-break-words h2 heading-{{ section.id }} items-center border-b-[0.5px] pb-2.5"
                :class="active == '{{ block.id }}' || 'opacity-80'"
                {% if section.settings.select_motion == 'hover' %}
                  @mouseover="active = '{{ block.id }}', open_first_tab = true, $refs.flow_container_{{ section.index }}.scrollIntoView()"
                {% else %}
                  @click="active = '{{ block.id }}', open_first_tab = true, $refs.flow_container_{{ section.index }}.scrollIntoView()"
                {% endif %}
              >
                <h3 class="acc-title--text w-[calc(100%-0.875rem)] text-[70%] heading--{{ section.id }}">
                  {% if block.settings.heading != blank %}
                    {{ block.settings.heading | escape }}
                  {% else %}
                    {% if block.type == 'product' %}
                      {{ block.settings.product.title | escape }}
                    {% endif %}
                    {% if block.type == 'collection' %}
                      {{ block.settings.collection.title | escape }}
                    {% endif %}
                  {% endif %}
                </h3>
                <span class="acc-arrow-icon block w-3.5 h-3.5 heading--{{ section.id }}" :style="(open_first_tab && active == '{{ block.id }}') ? 'transform:rotate(45deg)' : 'transform:rotate(0deg)'">
                  {% render 'icon-alls', icon: 'icon-up-right' %}
                </span>
              </span>
              <div 
                x-show="open_first_tab && active == '{{ block.id }}'" 
                class="acc-text--text font-normal leading-normal text--{{ section.id }} duration-300"
                x-cloak
                x-collapse
              >
                <div>
                  <div class="rte block h-full min-h-[0.5rem]">
                    {% if block.settings.description != blank %}
                      {% if block.type == 'product' %}
                        {%- render 'truncate-text', 
                          number_of_lines_shown: block.settings.number_of_lines_shown 
                          blockID: block.id,
                          content: block.settings.description,
                          read_more_label: block.settings.read_more_label,
                          see_less_label: block.settings.see_less_label,
                          text_alignment_mobile: section.settings.content_alignment,
                          text_alignment: section.settings.content_alignment,
                        -%}
                      {% else %}
                        {{ block.settings.description }}
                      {% endif %}
                    {% endif %}
                  </div>
                  {% if block.settings.button_text != blank %}
                    {%- liquid
                      assign link = false
                      if block.settings.button_link != blank
                        assign link = block.settings.button_link
                      elsif block.type == 'product' and block.settings.product != blank
                        assign link = block.settings.product.url
                      elsif block.type == 'collection' and block.settings.collection != blank
                        assign link = block.settings.collection.url
                      endif
                    -%}
                    <div {{ block.shopify_attributes }}>
                      {% if block.settings.show_button_style == 'text-link' %}
                        {% if link == blank %}
                          <div class="button button-text-link leading-normal empty:hidden text-center pl-7 pr-7 pt-2.5 pb-2.5 md:pl-8 md:pr-8 md:pt-3 md:pb-3 opacity-70 hover:cursor-not-allowed">
                            {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                          </div>
                        {% else %}
                          <a class="button button-text-link py-2 px-4" href="{{ link }}"{% if block.settings.open_new_window_button %} target="_blank"{% endif %}>
                            {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                          </a>
                        {% endif %}
                      {% else %}  
                        {% if link %}
                          <button class="button{% if block.settings.show_button_style == 'secondary' %} button-outline mt-2{% else %} button-solid mt-2{% endif %} py-2 px-4"
                            {% if block.settings.open_new_window_button %}
                              @click="window.open('{{ link }}', '_blank')"
                            {% else %}
                              @click="window.location.href='{{ link }}'"
                            {% endif %}
                          >
                            {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                          </button>
                        {% else %}
                          <button class="button{% if block.settings.show_button_style == 'secondary' %} button-outline mt-2{% else %} button-solid mt-2{% endif %} px-4 py-2 opacity-70 hover:cursor-not-allowed">
                            {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                          </button>
                        {% endif %}
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </li>
                {% endcase %}
          {% endfor %}
        </ul>

        {% for block in section.blocks %}
          {% case block.type %} 
              {% when 'button' %}
                    <div class="acc-tabs-action w-full">

                    {% if block.settings.button_text != blank %}
                    {%- liquid
                      assign link = false
                      if block.settings.button_link != blank
                        assign link = block.settings.button_link 
                      endif
                    -%}
                    {% endif %}

                    {% if block.settings.button_text_2 != blank %}
                    {%- liquid
                      assign link_2 = false
                      if block.settings.button_link_2 != blank
                        assign link_2 = block.settings.button_link_2 
                      endif
                    -%}
                    {% endif %}  
                       
                            {% if block.settings.show_button_style == 'text-link' %}
                            {% if link == blank %}
                                <div class="1 button button-text-link leading-normal empty:hidden text-center pl-7 pr-7 pt-2.5 pb-2.5 md:pl-8 md:pr-8 md:pt-3 md:pb-3 opacity-70 hover:cursor-not-allowed">
                                {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                                </div>
                            {% else %}
                                <a class="2 button button-text-link py-2 px-4" href="{{ link }}"{% if block.settings.open_new_window_button %} target="_blank"{% endif %}>
                                {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                                </a>
                            {% endif %}
                            {% else %}  
                            {% if link %}
                                <button class="3 button{% if block.settings.show_button_style == 'secondary' %} button-outline mt-2{% else %} button-solid mt-2{% endif %} py-2 px-4"
                                {% if block.settings.open_new_window_button %}
                                    @click="window.open('{{ link }}', '_blank')"
                                {% else %}
                                    @click="window.location.href='{{ link }}'"
                                {% endif %}
                                >
                                {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                                </button>
                            {% else %}
                                <button class="4 button{% if block.settings.show_button_style == 'secondary' %} button-outline mt-2{% else %} button-solid mt-2{% endif %} px-4 py-2 opacity-70 hover:cursor-not-allowed">
                                {% render 'button-label', button_label: block.settings.button_text, show_button_style: block.settings.show_button_style %}
                                </button>
                            {% endif %}
                            {% endif %}


                     {% if block.settings.show_button_style_2 == 'text-link' %}
                            {% if link_2 == blank %}
                                <div class="button button-text-link leading-normal empty:hidden text-center pl-7 pr-7 pt-2.5 pb-2.5 md:pl-8 md:pr-8 md:pt-3 md:pb-3 opacity-70 hover:cursor-not-allowed">
                                {% render 'button-label', button_label: block.settings.button_text_2, show_button_style: block.settings.show_button_style_2 %}
                                </div>
                            {% else %}
                                <a class="button button-text-link py-2 px-4" href="{{ link_2 }}"{% if block.settings.open_new_window_button_2 %} target="_blank"{% endif %}>
                                {% render 'button-label', button_label: block.settings.button_text_2, show_button_style: block.settings.show_button_style_2 %}
                                </a>
                            {% endif %}
                            {% else %}  
                            {% if link_2 %}
                                <button class="button{% if block.settings.show_button_style_2 == 'secondary' %} button-outline mt-2{% else %} button-solid mt-2{% endif %} py-2 px-4"
                                {% if block.settings.open_new_window_button_2 %}
                                    @click="window.open('{{ link_2 }}', '_blank')"
                                {% else %}
                                    @click="window.location.href='{{ link_2 }}'"
                                {% endif %}
                                >
                                {% render 'button-label', button_label: block.settings.button_text_2, show_button_style: block.settings.show_button_style_2 %}
                                </button>
                            {% else %}
                                <button class="button{% if block.settings.show_button_style_2 == 'secondary' %} button-outline mt-2{% else %} button-solid mt-2{% endif %} px-4 py-2 opacity-70 hover:cursor-not-allowed">
                                {% render 'button-label', button_label: block.settings.button_text_2, show_button_style: block.settings.show_button_style_2 %}
                                </button>
                            {% endif %}
                            {% endif %}
                           
                    </div>
               {% endcase %}
        {% endfor %}

      
      </div>
</div>
      <div class="image-column-wrap 3 w-full h-full md:col-span-3 md:flex items-start">
        <div class="image-column-inner 4 w-full relative md:sticky md:top-[var(--height-header)]{% if section.blocks.size > 0 %} section-height--{{ section.id }}{% endif %} border-radius-{{ section.id }}">
          {% for block in section.blocks %}
            {% case block.type %} 
              {% when 'media' %}
              
                <div class="acc-image-wrap {% unless block.settings.image_2 != blank %}acc-single--image{% endunless %} w-full h-full border-radius-{{ section.id }}"> 

                  {%- if block.settings.image_1 != blank -%} 
                  <div class="acc-image_1"> 
                      {%- if block.settings.image_1 != blank -%} 
                         <img
                           src="{{ block.settings.image_1 | image_url: width: 1024 }}"
                           width="{{ block.settings.image_1.width }}"
                           height="{{ block.settings.image_1.height }}"
                           loading="lazy"
                           alt="{{ block.settings.image_1.alt | escape }}">
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: class_img }}
                      {%- endif -%}
                  </div>
                  {%- endif -%}
                  
                  {%- if block.settings.image_2 != blank -%} 
                  <div class="acc-image_2"> 
                      {%- if block.settings.image_2 != blank -%} 
                         <img
                           src="{{ block.settings.image_2 | image_url: width: 1024 }}"
                           width="{{ block.settings.image_2.width }}"
                           height="{{ block.settings.image_2.height }}"
                           loading="lazy"
                           alt="{{ block.settings.image_2.alt | escape }}">
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: class_img }}
                      {%- endif -%}
    
                      {%- if block.settings.image_alt != blank -%} 
                        <div class="acc-alt--image"> 
                          <img
                            src="{{ block.settings.image_alt | image_url: width: 1024 }}"
                            width="{{ block.settings.image_alt.width }}"
                            height="{{ block.settings.image_alt.height }}"
                            loading="lazy"
                            alt="{{ block.settings.image_alt.alt | escape }}">
                        </div>
                      {%- endif -%} 
                  </div>
                  {%- endif -%} 
                  
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
</div>
</div>
{% schema %}
{
  "name": "Image with accordion",
  "tag": "section",
  "class": "section section-flow x-section image-with-accordion",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.text.heading",
      "default": "Flow",
      "info": "t:settings_schema.typography.settings.heading_highlight_type.info"
    },
    {
      "type": "select",
      "id": "highlight_type",
      "default": "underline",
      "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
      "options": [
        {
          "value": "underline",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
        },
        {
          "value": "font_highlight",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 50,
      "max": 200,
      "unit": "%",
      "step": 10,
      "default": 130,
      "label": "t:sections.flow.settings.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "default": "center",
      "label": "t:sections.flow.settings.heading_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "default": "middle",
      "label": "t:sections.flow.settings.content_position.label",
      "options": [
        {
          "value": "top",
          "label": "t:sections.flow.settings.content_position.options__1.label"
        },
        {
          "value": "middle",
          "label": "t:sections.flow.settings.content_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.flow.settings.content_position.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "default": "left",
      "label": "t:sections.flow.settings.content_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "select_motion",
      "options": [
        {
          "value": "hover",
          "label": "t:sections.flow.settings.select_motion.option_1"
        },
        {
          "value": "click",
          "label": "t:sections.flow.settings.select_motion.option_2"
        }
      ],
      "default": "hover",
      "label": "t:sections.flow.settings.select_motion.label"
    },
    {
      "type": "checkbox",
      "id": "open_first_tab",
      "default": true,
      "label": "t:sections.flow.settings.open_first_tab.label"
    },
    {
      "type": "range",
      "id": "image_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "t:sections.flow.settings.corner_radius.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.flow.settings.styles.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.flow.settings.heading_color.label",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.flow.settings.text_color.label",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.flow.settings.background_color.label",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "heading_color_dark",
      "label": "t:sections.flow.settings.heading_color_dark.label",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color_dark",
      "label": "t:sections.flow.settings.text_color_dark.label",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background_color_dark",
      "label": "t:sections.flow.settings.background_color_dark.label",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "first",
          "label": "t:sections.flow.settings.image_position.options__1.label"
        },
