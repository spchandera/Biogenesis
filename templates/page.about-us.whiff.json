gnment_mobile":"left","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":0}},"024df5c5-5fe3-46fa-8380-7d6cc1f91912":{"type":"image-with-text","blocks":{"template--21744477274413__024df5c5-5fe3-46fa-8380-7d6cc1f91912-heading-1":{"type":"heading","settings":{"subheading":"","heading":"The only \"Australian Made, Australian Grown\" licensed producer of Chlorella.","highlight_type":"underline","heading_base_size":100,"heading_tag":"h2","text":"<p>We’re proudly 100% Australian owned and operated. We take pride in our Aussie roots, operating in a country known for its unique biodiversity and stringent quality standards. From our farm in tropical Queensland, right through to packing and distribution, our products are grown and processed in Australia to the highest quality standard.<\/p><h5><\/h5><h5><\/h5><p>Australian-grown Chlorella benefits from the clean air, water, and abundant sunlight, contributing to its superior quality. Supporting BioGenesis means supporting local Australian agriculture, helping to sustain the local economy and job market.<\/p>","number_of_lines_shown":"none","read_more_label":"Read more","see_less_label":"See less","heading_light":"#174739","text_light":"#174739","color_heading_highlight_light":"rgba(0,0,0,0)","heading_dark":"rgba(0,0,0,0)","text_dark":"rgba(0,0,0,0)","color_heading_highlight_dark":"rgba(0,0,0,0)"}}},"block_order":["template--21744477274413__024df5c5-5fe3-46fa-8380-7d6cc1f91912-heading-1"],"custom_css":["@media (max-width: 767px) {.iwt-content {padding-bottom: 28px; }}"],"settings":{"show_hero":false,"image":"shopify:\/\/shop_images\/052A6554_1.png","image_second":"shopify:\/\/shop_images\/Mobile_2a98a2c9-d60d-44c7-9e4d-e594f5b1e878_1.jpg","show_sound_control":false,"video_url":"","video_alt_text":"","enable_video_autoplay":false,"desktop_height":"450px","mobile_height":"300px","desktop_image_width":"medium","image_layout":"stacked","image_corner_radius":10,"content_layout":"no-overlap","spacing_